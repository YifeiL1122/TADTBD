<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>T-Mobile Ad Management System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <h1>T-Mobile</h1>
                <p>Ad Management System</p>
            </div>
            <nav class="nav-tabs">
                <button class="tab-btn active" data-tab="upload">Upload Ad</button>
                <button class="tab-btn" data-tab="current">Current Ads</button>
                <button class="tab-btn" data-tab="history">History</button>
            </nav>
        </header>

        <!-- Upload Section -->
        <section id="upload" class="tab-content active">
            <div class="upload-area">
                <h2>Upload New Advertisement</h2>
                <div class="upload-form">
                    <div class="upload-box" id="uploadBox">
                        <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <p>Drag & drop image here or click to upload</p>
                        <input type="file" id="fileInput" accept="image/*" hidden>
                        <button class="btn-primary" onclick="document.getElementById('fileInput').click()">Choose File</button>
                    </div>

                    <div class="form-group">
                        <label for="adTitle">Ad Title</label>
                        <input type="text" id="adTitle" placeholder="Enter ad title">
                    </div>

                    <div class="form-group">
                        <label for="adDescription">Ad Description</label>
                        <textarea id="adDescription" rows="3" placeholder="Enter ad description"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="adDuration">Display Duration (seconds)</label>
                        <input type="number" id="adDuration" value="10" min="1" max="60">
                    </div>
                </div>

                <!-- Preview Section -->
                <div class="preview-section" id="previewSection" style="display: none;">
                    <h3>Preview</h3>
                    <div class="preview-container">
                        <img id="previewImage" src="" alt="Preview">
                        <div class="preview-info">
                            <h4 id="previewTitle"></h4>
                            <p id="previewDesc"></p>
                            <p class="preview-duration">Duration: <span id="previewDuration"></span>s</p>
                        </div>
                    </div>
                    <div class="button-group">
                        <button class="btn-primary" id="saveAdBtn">Save Ad</button>
                        <button class="btn-secondary" id="cancelBtn">Cancel</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Current Ads Section -->
        <section id="current" class="tab-content">
            <h2>Active Advertisements</h2>
            <div class="ads-grid" id="currentAdsGrid">
                <p class="empty-message">No active ads</p>
            </div>
        </section>

        <!-- History Section -->
        <section id="history" class="tab-content">
            <h2>Ad History</h2>
            <div class="filter-bar">
                <input type="text" id="searchInput" placeholder="Search ad title...">
                <select id="sortSelect">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="title">By Title</option>
                </select>
            </div>
            <div class="ads-grid" id="historyAdsGrid">
                <p class="empty-message">No archived ads</p>
            </div>
        </section>
    </div>

    <!-- Edit Modal -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Edit Advertisement</h2>
            <div class="edit-form">
                <div class="form-group">
                    <label for="editTitle">Ad Title</label>
                    <input type="text" id="editTitle">
                </div>
                <div class="form-group">
                    <label for="editDescription">Ad Description</label>
                    <textarea id="editDescription" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="editDuration">Display Duration (seconds)</label>
                    <input type="number" id="editDuration" min="1" max="60">
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="editActive">
                        Active Status
                    </label>
                </div>
                <div class="button-group">
                    <button class="btn-primary" id="saveEditBtn">Save Changes</button>
                    <button class="btn-secondary" id="cancelEditBtn">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Modal -->
    <div id="viewModal" class="modal">
        <div class="modal-content modal-large">
            <span class="close view-close">&times;</span>
            <div class="view-ad-container">
                <img id="viewImage" src="" alt="Advertisement">
                <div class="view-info">
                    <h2 id="viewTitle"></h2>
                    <p id="viewDescription"></p>
                    <div class="view-meta">
                        <p><strong>Duration:</strong> <span id="viewDuration"></span>s</p>
                        <p><strong>Created:</strong> <span id="viewCreated"></span></p>
                        <p><strong>Status:</strong> <span id="viewStatus" class="status-badge"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
